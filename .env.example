# ----------------------------------------------------------------------------
# GachaFi — environment configuration
# ----------------------------------------------------------------------------
# ⚠️  SECURITY NOTICE — VITE_ prefix exposure
# Anything prefixed VITE_ is BUNDLED INTO THE CLIENT JS at build time. Anyone
# who downloads the app can read these values in the compiled bundle. NEVER put
# server secrets, private keys, or confidential API tokens here.
#
# For real secrets you need a backend server (Edge Functions, API routes, etc.)
# with environment variables that stay server-side.
#
# Currently exposed values are safe by design:
#   • OneSignal App ID  → public identifier (intentionally visible)
#   • Sentry DSN        → designed to be public
#   • Radix addresses   → already public on-chain data
#   • Feature flags     → public configuration
#
# If you add a new VITE_ variable, ask: "Would I post this on a public billboard?"
# If the answer is no, it belongs in a backend env var, not here.
# ----------------------------------------------------------------------------

# --- OneSignal (web push) ---------------------------------------------------
# Required for push notifications. Get from https://onesignal.com/
# Leave blank to disable push entirely (UI gracefully degrades).
VITE_ONESIGNAL_APP_ID=
VITE_ONESIGNAL_SAFARI_WEB_ID=

# --- Radix network ----------------------------------------------------------
# stokenet (testnet) or mainnet
VITE_RADIX_NETWORK=stokenet

# Your dApp definition account address (on the chosen network).
# Stokenet placeholder: account_tdx_2_129vr3rwyz7gnwf35kkuxvx0fs4hkz0n5hem9utaejqra3sxf0m5wej
VITE_RADIX_DAPP_DEFINITION=

# Babylon Gateway URL. Defaults differ per network — only override if you self-host.
# Stokenet: https://babylon-stokenet-gateway.radixdlt.com
# Mainnet:  https://mainnet.radixdlt.com
VITE_RADIX_GATEWAY_URL=

# --- Gacha component (the Scrypto package you deployed) ---------------------
# These MUST be set before the mint flow will work. With them empty the mint
# button is disabled and the UI shows a "not yet deployed" notice.
VITE_GACHA_PACKAGE_ADDRESS=
VITE_GACHA_COMPONENT_ADDRESS=

# XRD resource address. Default fits each network; only override for unusual setups.
# Stokenet: resource_tdx_2_1tknxxxxxxxxxradxrdxxxxxxxxx009923554798xxxxxxxxxtfd2jc
# Mainnet:  resource_rdx1tknxxxxxxxxxradxrdxxxxxxxxx009923554798xxxxxxxxxradxrd
VITE_XRD_RESOURCE_ADDRESS=

# --- Feature flags ----------------------------------------------------------
# Cross-chain bridge UI (currently a non-functional placeholder, off by default)
VITE_FEATURE_BRIDGE=false

# Offline mint queue (conceptually limited — wallet signing requires online).
# When false the offline UI is hidden and queued requests are not replayed.
VITE_FEATURE_OFFLINE_QUEUE=false

# Creator dashboard (returns honest zeros until on-chain reads land).
VITE_FEATURE_CREATOR_DASHBOARD=true

# --- Observability (optional) ---------------------------------------------
# Sentry DSN for error tracking. Leave blank to disable.
# Get from https://sentry.io/
VITE_SENTRY_DSN=

# --- App metadata -----------------------------------------------------------
VITE_APP_NAME=GachaFi
VITE_APP_VERSION=1.0.0
